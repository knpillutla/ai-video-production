# ==============================================================================
# Professional AI Video Producer Studio - Environment Configuration Template
# Copy this file to .env and configure your local or production credentials.
# ==============================================================================

# Core App & Security
APP_NAME="Professional AI Video Producer Studio"
APP_ENV=development
API_PORT=8000
JWT_SECRET=super-secret-studio-jwt-encryption-key-for-local-development-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
ENCRYPTION_MASTER_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=
CORS_ORIGINS=["http://localhost:3000"]
MOCK_ALL_MODELS=false

# Google OAuth 2.0 (SSO)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Multi-Tenant Storage (local | azure | gcs)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage

# Microsoft Azure Blob Storage (Optional if STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# Google Cloud Storage (Optional if STORAGE_BACKEND=gcs)
GCS_PROJECT_ID=
GCS_BUCKET_PREFIX=studio
GCS_CREDENTIALS_FILE=

# Database & Message Queue
DATABASE_URL=sqlite+aiosqlite:///./storage/studio_local.db
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# External AI Model Provider API Keys (Phase 2 & Phase 3 Integrated Models)
# ------------------------------------------------------------------------------
# NOTE: If keys are left blank, high-fidelity deterministic local fallbacks run
# automatically. When testing models as part of automated tests (pytest), all
# calls run 100% locally with offline mocks even if keys are populated below!
# ==============================================================================

# 1. Creative Scriptwriting & Retention Hooks (Tier 2 & Tier 1 LLMs)
# Google Gemini 1.5 Pro / Flash (Primary scriptwriting & transcreation)
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Anthropic Claude 3.5 Sonnet (Alternative flagship scriptwriter)
ANTHROPIC_API_KEY=
# OpenAI GPT-4o / GPT-4o-mini (Alternative fast summarizer & schema extractor)
OPENAI_API_KEY=

# 2. 4K Photoreal Visual Diffusion (Phase 2)
# Together AI - Black Forest Labs FLUX.1-schnell ($0.003/image)
TOGETHER_API_KEY=

# 3. Multilingual Studio Voiceovers & Narration (Phase 2 & Phase 3)
# Microsoft Azure Cognitive Services Speech Neural HD (48kHz broadcast audio)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# ElevenLabs Multilingual v2 Voice Engine (Alternative voice actor provider)
ELEVENLABS_API_KEY=

# 4. Commercially Cleared Soundtracks & Background Music (Phase 2)
# Suno v3.5 Pro API ($0.08/track royalty-cleared soundtrack generation)
SUNO_API_KEY=

# 5. Talking Avatar Lip-Sync & Video Motion Dynamics (Phase 3)
# Fal.ai LivePortrait (Speech phoneme avatar animation @ $0.012/sec)
FAL_KEY=
FAL_API_KEY=
# Alternative Video Motion Diffusion Providers (Phase 4 & 5)
RUNWAY_API_KEY=
KLING_API_KEY=

# 6. YouTube Data API v3 (Phase 3 & Phase 5 Publishing & Multi-Channel)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/channels/youtube/callback

# 7. SaaS Billing & Subscriptions (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
