# ==============================================================================
# Professional AI Video Producer Studio - Environment Configuration Template
# Copy this file to .env and configure your local or production credentials.
# ==============================================================================

# Core App & Security
APP_NAME="Professional AI Video Producer Studio"
APP_ENV=development
API_PORT=8000
JWT_SECRET=replace-with-a-secure-random-32-character-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
ENCRYPTION_MASTER_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=
CORS_ORIGINS=["http://localhost:3000"]

# Google OAuth 2.0 (SSO)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Multi-Tenant Storage (local | azure | gcs)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage

# Database & Message Queue
DATABASE_URL=sqlite+aiosqlite:///./storage/studio_local.db
REDIS_URL=redis://localhost:6379/0

# Cloud AI Provider API Keys (Optional - Zero-cost fallback active if unset)
# GEMINI_API_KEY=
# TOGETHER_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# SUNO_API_KEY=
# FAL_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
