# ==============================================================================
# Git Ignore - Professional AI Video Producer Studio
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions & binaries
*.so
*.pyd
*.dll
*.exe

# Environments & Secrets
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/
config/tokens/
config/tokens/*
config/*secret*.json
config/*token*.json
config/*credential*.json
*client_secret*.json
token_*.json
*.token
*.pem
*.key
*.cert

# Local Storage, SQLite Databases & Generated Media Renders
storage/*
!storage/.gitignore
!storage/.gitkeep
*.db
*.sqlite
*.sqlite3

# Media Files & Large Assets (Generated during production)
*.mp4
*.wav
*.mp3
*.aac
*.jpg
*.jpeg
*.png
*.webp

# Machine Learning Models, Checkpoints & Large Binary Weights
models/
models/*
!models/.gitkeep
tools/
tools/*
checkpoints/
weights/
*.onnx
*.pth
*.pt
*.pth.tar
*.safetensors
*.bin
*.ckpt
*.weights
*.pkl
*.pickle
*.h5
*.tflite
*.engine
*.plan

# Archives & Compressed Packages
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Node / JS Packages
node_modules/

# Scratch & Temporary Testing Directories
scratch/
tmp/
temp/

# Unit test & coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Packaging & Builds
build/
dist/
*.egg-info/
*.egg

# Logs
logs/
*.log

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
