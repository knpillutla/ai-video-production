# ==============================================================================
# Professional AI Video Producer Studio - Local Configuration Template
# ==============================================================================

# Core App & Security
APP_NAME="Professional AI Video Producer Studio"
APP_ENV=development
API_PORT=8000
JWT_SECRET=super-secret-studio-jwt-encryption-key-for-local-development-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
ENCRYPTION_MASTER_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=
CORS_ORIGINS=["http://localhost:3000"]

# Google OAuth 2.0 (SSO)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Multi-Tenant Storage (local | azure | gcs)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage

# Microsoft Azure Blob Storage (Optional if STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# Google Cloud Storage (Optional if STORAGE_BACKEND=gcs)
GCS_PROJECT_ID=
GCS_BUCKET_PREFIX=studio
GCS_CREDENTIALS_FILE=

# Database & Message Queue
DATABASE_URL=sqlite+aiosqlite:///./storage/studio_local.db
REDIS_URL=redis://localhost:6379/0

# External AI Provider APIs (0 Local GPU - Serverless Pay-Per-Second)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
ELEVENLABS_API_KEY=
TOGETHER_API_KEY=
SUNO_API_KEY=
FAL_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
