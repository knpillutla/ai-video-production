        "scenic_walking_tour": {
          "script": { "provider": "Google", "model": "gemini-1.5-pro", "temperature": 0.7 },
          "visual": {
            "provider": "Fal.ai",
            "model": "FLUX.1-dev",
            "endpoint": "https://queue.fal.run/fal-ai/flux/dev",
            "resolution": { "width": 1920, "height": 1080 },
            "num_inference_steps": 30,
            "guidance_scale": 3.5,
            "optical_prompt_suffix": "Tack-sharp 8K UHD optical clarity, Sony FX3 24mm prime lens f/4, edge-to-edge sharpness, crisp architectural micro-textures, zero haze, balanced 5500K daylight"
          },
          "video_motion": {
            "provider": "Fal.ai",
            "model": "Kling 1.5 Pro",
            "endpoint": "https://queue.fal.run/fal-ai/kling-video/v1.5/pro/image-to-video",
            "duration": 10,
            "mode": "pro",
            "cfg_scale": 0.55,
            "pacing": "ultra_slow_stroll_1_5_kmh",
            "negative_prompt": "blurry, low quality, distortion, noise, compression artifacts, fast motion, running, drone rushes, sudden turns, jitter, flickers, overexposed, soft focus, haze"
          },
          "lipsync": { "provider": "None", "model": "none", "enabled": false },
          "tts": {
            "provider": "Microsoft",
            "model": "Azure Speech Neural HD",
            "default_voice": "en-US-ChristopherNeural",
            "pacing_wpm": 125
          },
          "soundtrack": {
            "provider": "Suno / Procedural DSP",
            "model": "v3.5-pro",
            "style": "Gentle rain drops, distant water cascades, and relaxing ambient nature sounds"
